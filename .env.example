# ─────────────────────────────────────────────────────────────────────────────
# bandy-bund.de — environment variables
# Copy to `.env` for local development. Never commit real secrets.
# In production these live in an .env owned by root (mode 600), encrypted at rest.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core -------------------------------------------------------------------
# Public origin of the site (no trailing slash). Used for canonical URLs, JSON-LD,
# sitemap, feeds and Payload admin CSRF/CORS.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# PostgreSQL 17 connection string used by Payload's postgres adapter.
DATABASE_URI=postgres://bandy:bandy@localhost:5432/bandy

# --- Payload ----------------------------------------------------------------
# Long random string used to sign/encrypt tokens. Generate with:
#   openssl rand -base64 48
PAYLOAD_SECRET=change-me-to-a-long-random-string

# --- AI assistant (Slice 4 — server-side only, never NEXT_PUBLIC_*) ---------
# Anthropic Messages API key. Exists only on the server. CI asserts it never
# appears in the client bundle.
# ANTHROPIC_API_KEY=
# AI_ASSIST_ENABLED=false
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Email (Slice 3) --------------------------------------------------------
# SMTP transport for transactional email (double opt-in, contact notifications).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Deutscher Bandy-Bund <no-reply@bandy-bund.de>"

# --- Analytics (Slice 1 later — cookieless) ---------------------------------
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=
