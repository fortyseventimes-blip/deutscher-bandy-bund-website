# ─────────────────────────────────────────────────────────────────────────────
# bandy-bund.de — PRODUCTION environment variables (interim local-tunnel setup)
# Copy to `.env.production` next to infra/compose.prod.yml. Never commit the
# real file — it holds real secrets. See docs/deploy-local-tunnel.md.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core -------------------------------------------------------------------
# The real public domain, https, no trailing slash. Baked into the client
# bundle at build time (NEXT_PUBLIC_*), so rebuild the image if this changes.
NEXT_PUBLIC_SERVER_URL=https://bandy-bund.de

# --- Database -----------------------------------------------------------------
# Only used inside the Docker network (the "db" hostname below) — pick a real
# password, it never leaves this machine.
POSTGRES_USER=bandy
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=bandy

# --- Payload ------------------------------------------------------------------
# Long random string used to sign/encrypt tokens. Generate one with:
#   openssl rand -base64 48
# (no OpenSSL on Windows? use https://www.grc.com/passwords.htm or Windows
# PowerShell: [Convert]::ToBase64String((1..48 | %{Get-Random -Max 256}))
PAYLOAD_SECRET=change-me-to-a-long-random-string

# The very first admin login, created once on first start if no admin exists
# yet. Change the password immediately after first login, from inside /admin.
SEED_ADMIN_EMAIL=admin@bandy-bund.de
SEED_ADMIN_PASSWORD=change-me-before-first-start

# --- Cloudflare Tunnel ---------------------------------------------------------
# From the Cloudflare dashboard: Zero Trust > Networks > Tunnels > Create a
# tunnel > connector type "Docker" > it shows a `docker run ... --token eyJ...`
# command — copy just the token value (the long string after --token).
# See docs/deploy-local-tunnel.md.
CLOUDFLARE_TUNNEL_TOKEN=
